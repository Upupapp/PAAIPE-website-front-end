{
  "extends": ["html-validate:recommended", "html-validate:document"],
  "rules": {
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "attribute-boolean-style": "off",
    "no-inline-style": "off",
    "require-sri": [
      "error",
      {
        "target": "crossorigin"
      }
    ]
  }
}
