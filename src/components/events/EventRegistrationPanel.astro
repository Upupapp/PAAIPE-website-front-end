---
/**
 * Section 5: the registration call to action, or the honest unavailable state.
 *
 * IT LINKS; IT NEVER SUBMITS. The canonical registration route is the source of
 * truth (Tab 01), and Tab 05 builds the form there. This panel offers a way to
 * reach it and nothing that looks like a control which could complete a
 * registration here.
 *
 * IT DECIDES NOTHING. Label, destination and whether a registration path exists
 * all come from the resolver - Tab 06's rule that "components must not reproduce
 * conditional state logic independently". This component chose its own label
 * from the action kind and ignored `actionLabel`, so the approved "Browse
 * upcoming events" on a full event was replaced by a link back to the page the
 * reader was already on. Two places deciding one thing is how they disagree.
 *
 * The supporting line appears only beside a real registration action, because it
 * describes what registering needs ("Email only · No password required"), not
 * what browsing needs.
 *
 * IT DOES NOT POSITION ITSELF. Stickiness belongs to the page's grid, which is
 * the only thing that knows whether a second column exists. A `sticky` prop here
 * would have let a caller float this panel on a phone, which is exactly what the
 * command warns against.
 *
 * WHEN `formEnabled` IS FALSE THERE IS NO LINK AT ALL - not a disabled-looking
 * one. The resolver has already decided the event cannot be registered for, and
 * a link to a page that will only repeat that is a wasted journey; the state and
 * its reason are stated here instead. This is the same rule the register route
 * applies to its own absent form.
 */
import Button from '../ui/Button.astro';
import { CTA_SUPPORTING_LINE } from '../../content/events-detail';
import type { EventActionModel } from '../../lib/event-action';
import type { EventAccess } from '../../content/event-record';

interface Props {
  action: EventActionModel;
  access: EventAccess;
}
const { action, access } = Astro.props;
---

<aside class="panel" aria-labelledby="event-registration" data-reveal>
  <h2 id="event-registration" class="panel__heading">Registration</h2>
  <p class="panel__state">{action.badge}</p>
  <p class="panel__message">{action.message}</p>
  {
    action.actionHref && action.actionLabel ? (
      <>
        <Button href={action.actionHref} variant={action.formEnabled ? 'primary' : 'secondary'}>
          {action.actionLabel}
        </Button>
        {action.formEnabled ? <p class="panel__support">{CTA_SUPPORTING_LINE[access]}</p> : null}
      </>
    ) : null
  }
</aside>

<style>
  .panel {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }
  .panel__heading {
    margin: 0;
    font-size: var(--text-h4);
  }
  .panel__state {
    margin: 0;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-heading);
  }
  .panel__message,
  .panel__support {
    margin: 0;
    color: var(--color-text-secondary);
  }

  /*
   * ONE calm border pass the first time the panel enters view, and once only -
   * `.is-revealed` is added by the shared reveal observer and never removed, so
   * the animation cannot loop. A pulsing registration panel is the "animated
   * urgency" the command forbids, and this is a single 480ms settle.
   *
   * It animates BORDER-COLOR, not a glow overlay: the command requires that a
   * glow never replace a border or a focus outline, and a border that changes
   * colour is still a border in forced-colors mode.
   */
  .js.motion-ready .panel.is-revealed {
    animation: panel-settle var(--motion-emphasis) var(--ease-standard) 1;
  }

  @keyframes panel-settle {
    from {
      border-color: var(--paaipe-cyan);
    }
    to {
      border-color: var(--color-border-subtle);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .js.motion-ready .panel.is-revealed {
      animation: none;
    }
  }
</style>
