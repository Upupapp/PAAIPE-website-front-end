---
/**
 * The current registration state, in words.
 *
 * The label comes from the ONE resolver, so a badge cannot describe a state the
 * page around it disagrees with.
 */
interface Props {
  label: string;
  tone: 'default' | 'info' | 'warning' | 'critical' | 'complete';
}
const { label, tone } = Astro.props;
---

<span class:list={['status', `status--${tone}`]}>{label}</span>

<style>
  .status {
    display: inline-block;
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    background: var(--color-surface-raised);
    color: var(--color-text-secondary);
    border-inline-start: 3px solid var(--color-border-control);
  }
  .status--default {
    border-inline-start-color: var(--color-status-success);
  }
  .status--warning {
    border-inline-start-color: var(--color-status-warning);
  }
  .status--critical {
    border-inline-start-color: var(--color-status-error);
  }
</style>
