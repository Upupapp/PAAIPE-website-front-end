---
/**
 * Section 2 of the detail hierarchy: the notice that must be read BEFORE the
 * page's optimistic content.
 *
 * It sits above the hero deliberately. A cancellation announced below a hero
 * that still says "Register for this event" has been announced in the wrong
 * order, and a reader who leaves at the fold never sees it.
 *
 * It renders only when the resolver gives it something to say - `tone` other
 * than 'default'. There is no "everything is fine" banner, because a banner
 * that is usually noise is a banner nobody reads.
 *
 * CANCELLATION IS CARRIED BY TEXT, NOT BY RED. The heading names the state in
 * words and the body explains it; the colour is an accent on the rule, and the
 * page reads identically without it - WCAG 2.2 SC 1.4.1, and Tab 06 says so
 * explicitly for this banner.
 */
import { MEMBERS_ONLY_NOTICE } from '../../content/events-detail';
import type { EventActionModel } from '../../lib/event-action';
import type { EventAccess } from '../../content/event-record';

interface Props {
  action: EventActionModel;
  access: EventAccess;
}
const { action, access } = Astro.props;
const show = action.tone !== 'default';
const membersOnly = access === 'members-only';
---

{
  /*
   * TWO NOTICES, NOT ONE MERGED INTO THE OTHER. The members-only notice states
   * a standing policy; the state notice reports what has happened to this
   * event. Folding them together would have made a cancelled members-only event
   * say one thing where it needs to say both, and the reader who most needs the
   * cancellation is the one already eligible to attend.
   */
  membersOnly && (
    <div class="notice notice--members" role="note">
      <p class="notice__badge">{MEMBERS_ONLY_NOTICE.eyebrow}</p>
      <p class="notice__body">{MEMBERS_ONLY_NOTICE.body}</p>
    </div>
  )
}

{
  show && (
    <div class:list={['notice', `notice--${action.tone}`]} role="status">
      <p class="notice__badge">{action.heading ?? action.badge}</p>
      <p class="notice__body">{action.message}</p>
    </div>
  )
}

<style>
  .notice {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border-inline-start: 4px solid currentColor;
    background: var(--color-surface-raised);
  }
  .notice__badge {
    margin: 0;
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .notice__body {
    margin: 0;
    color: var(--color-text-primary);
  }
  .notice--info {
    color: var(--color-link);
  }
  .notice--warning {
    color: var(--color-status-warning);
  }
  .notice--critical {
    color: var(--color-status-error);
  }
  .notice--complete {
    color: var(--color-text-secondary);
  }
  .notice--members {
    color: var(--color-link);
  }
</style>
