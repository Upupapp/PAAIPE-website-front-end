---
/**
 * The mobile filter sheet.
 *
 * A NATIVE `<dialog>` opened with `showModal()`, which gives focus trapping,
 * Escape-to-close, background inertness and focus return to the opener for
 * free — all four of which the command requires and all four of which are easy
 * to get subtly wrong by hand.
 *
 * IT DOES NOT DUPLICATE THE CONTROLS. On open, the single toolbar node is MOVED
 * into the dialog and moved back on close. Two copies of the same filters would
 * be two sources of state, and they would disagree the first time someone used
 * one and then the other.
 */
---

<button class="sheet__open" type="button" data-sheet-open aria-haspopup="dialog">
  Filters <span data-sheet-count></span>
</button>

<dialog class="sheet" data-sheet aria-label="Filter events">
  <div class="sheet__body" data-sheet-slot></div>
  <div class="sheet__footer">
    <button class="sheet__apply" type="button" data-sheet-close>Show results</button>
  </div>
</dialog>

<style>
  .sheet__open {
    display: none;
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font: inherit;
    cursor: pointer;
  }
  .sheet {
    width: min(100%, 32rem);
    margin-inline: auto;
    margin-block-end: 0;
    border: none;
    border-start-start-radius: var(--radius-lg);
    border-start-end-radius: var(--radius-lg);
    padding: var(--space-5);
    /* Safe-area inset so the apply button clears a home indicator. */
    padding-block-end: calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
  }
  .sheet::backdrop {
    background: rgb(3 13 31 / 0.5);
  }
  .sheet__footer {
    margin-top: var(--space-5);
  }
  .sheet__apply {
    width: 100%;
    min-height: 44px;
    border: none;
    border-radius: var(--radius-md);
    background: var(--color-action-bg);
    color: var(--color-text-inverse);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  @media (max-width: 47.999em) {
    .sheet__open {
      display: inline-flex;
      gap: var(--space-2);
      align-items: center;
    }
  }
</style>
