---
/**
 * The locked panel for a members-only resource.
 *
 * Nothing here is a file URL, a signed URL, a replay link or a filename that
 * would reveal protected content. The only destinations are the two external
 * handoffs and a link back to the public resource list.
 */
import Button from '../ui/Button.astro';
import ExternalAction from '../ui/ExternalAction.astro';
import { MEMBER_RESOURCE_LOCK } from '../../content';
---

<section class="lock" aria-labelledby="member-resource-lock-heading">
  <p class="lock__label">{MEMBER_RESOURCE_LOCK.label}</p>
  <h2 class="lock__heading" id="member-resource-lock-heading">{MEMBER_RESOURCE_LOCK.heading}</h2>
  <p>{MEMBER_RESOURCE_LOCK.body}</p>
  <div class="lock__actions">
    <ExternalAction
      action="membership-application"
      label={MEMBER_RESOURCE_LOCK.applyCta}
      variant="primary"
      onDark
    />
    <ExternalAction
      action="member-portal"
      label={MEMBER_RESOURCE_LOCK.signInCta}
      variant="secondary"
      onDark
    />
    <Button as="a" href="/resources" variant="ghost" onDark>
      {MEMBER_RESOURCE_LOCK.relatedCta}
    </Button>
  </div>
</section>

<style>
  .lock {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-8);
    background: var(--color-surface-inverse-deep);
    color: var(--color-text-inverse);
    border-radius: var(--radius-xl);
  }
  .lock__label {
    margin: 0;
    font-size: var(--text-caption);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    color: var(--color-text-highlight-on-dark);
  }
  .lock__heading {
    margin: 0;
    font-size: var(--text-h3);
    color: var(--color-text-inverse);
  }
  .lock__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-4);
  }
</style>
