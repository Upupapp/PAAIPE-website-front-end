---
/**
 * One card in the /resources library, in the owner's card anatomy (Resources
 * mockup, 2026-09-15, F-77): a drawn head carrying the status and the medium,
 * then how you get it, what it is, what it is about, and the one action.
 *
 * An announcement has no `action`, so it renders no link and no button - not
 * even a disabled one. Nothing exists to open, and a disabled control is still
 * a control that does nothing. "Not available yet" is text.
 *
 * A link that leaves the site says so in its accessible name, host included,
 * because following it is the moment that host's own scripts run.
 *
 * Status never rests on colour: every pill is a word, and the two states a
 * visitor acts on add a glyph.
 */
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { LibraryItem } from '../../lib/resource-library';

type Props = LibraryItem;
const { title, description, topic, format, medium, detail, status, action } = Astro.props;

const STATUS_LABEL = {
  published: { glyph: '✓', label: 'Published' },
  'members-only': { glyph: '', label: 'Members only' },
  sample: { glyph: '', label: 'Sample - not published' },
  'coming-soon': { glyph: '!', label: 'Coming soon' },
} as const;
const statusLabel = STATUS_LABEL[status];

/** Stroke paths in a 24x24 box. Decorative: the medium pill carries the meaning. */
const ICONS: Readonly<Record<string, readonly string[]>> = {
  Explainer: ['M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z', 'M14 2v6h6'],
  Checklist: [
    'M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z',
    'M7 8h10M7 12h10M7 16h6',
  ],
  Guide: [
    'M4 5.5C4 4.1 5.1 3 6.5 3H12v18H6.5C5.1 21 4 19.9 4 18.5z',
    'M20 5.5C20 4.1 18.9 3 17.5 3H12v18h5.5c1.4 0 2.5-1.1 2.5-2.5z',
  ],
  Template: [
    'M4.4 3h4.2A1.4 1.4 0 0 1 10 4.4v4.2A1.4 1.4 0 0 1 8.6 10H4.4A1.4 1.4 0 0 1 3 8.6V4.4A1.4 1.4 0 0 1 4.4 3z',
    'M15.4 3h4.2A1.4 1.4 0 0 1 21 4.4v4.2a1.4 1.4 0 0 1-1.4 1.4h-4.2A1.4 1.4 0 0 1 14 8.6V4.4A1.4 1.4 0 0 1 15.4 3z',
    'M4.4 14h4.2a1.4 1.4 0 0 1 1.4 1.4v4.2A1.4 1.4 0 0 1 8.6 21H4.4A1.4 1.4 0 0 1 3 19.6v-4.2A1.4 1.4 0 0 1 4.4 14z',
    'M15.4 14h4.2a1.4 1.4 0 0 1 1.4 1.4v4.2a1.4 1.4 0 0 1-1.4 1.4h-4.2a1.4 1.4 0 0 1-1.4-1.4v-4.2a1.4 1.4 0 0 1 1.4-1.4z',
  ],
  Presentation: [
    'M4.5 4h15A1.5 1.5 0 0 1 21 5.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 14.5v-9A1.5 1.5 0 0 1 4.5 4z',
    'M12 16v4M8 20h8',
  ],
};
const iconPaths = ICONS[format] ?? ICONS['Explainer'] ?? [];
const headTone = format.toLowerCase().replace(/\s+/g, '-');
---

<article class="lib-card" data-format={format} data-status={status}>
  <div class:list={['lib-card__head', `lib-card__head--${headTone}`]}>
    {
      format === 'Video' ? (
        <span class="lib-card__play" aria-hidden="true" />
      ) : (
        <svg class="lib-card__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          {iconPaths.map((d) => (
            <path d={d} />
          ))}
        </svg>
      )
    }
    <div class="lib-card__pills">
      <span class:list={['lib-card__status', `lib-card__status--${status}`]}>
        {statusLabel.glyph && <span aria-hidden="true">{statusLabel.glyph}</span>}
        {statusLabel.label}
      </span>
      <span class="lib-card__medium">{medium}</span>
    </div>
  </div>

  <div class="lib-card__body">
    <p class="lib-card__detail">{detail}</p>
    <SectionHeading as="h3" size="sm">{title}</SectionHeading>
    <p class="lib-card__description">{description}</p>
    <p class="lib-card__topic">{topic}</p>
    <div class="lib-card__foot">
      {
        action ? (
          <Button as="a" href={action.href} variant="accent" external={Boolean(action.host)}>
            {action.label}
            {action.host && <span class="sr-only"> on {action.host}, opens in a new tab</span>}
          </Button>
        ) : (
          <p class="lib-card__unavailable">Not available yet</p>
        )
      }
    </div>
  </div>
</article>

<style>
  .lib-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  /* A fixed height, so a head can never shift layout at any width. */
  .lib-card__head {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    height: 11rem;
    color: var(--paaipe-white);
    background: linear-gradient(135deg, var(--paaipe-navy), var(--paaipe-navy-deep));
  }
  /* Decorative hatching. It carries nothing, so it sits behind everything. */
  .lib-card__head::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: repeating-linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.08) 0 2px,
      transparent 2px 16px
    );
  }
  .lib-card__head--checklist {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--paaipe-blue) 55%, var(--paaipe-navy)),
      var(--paaipe-navy)
    );
  }
  .lib-card__head--guide {
    background: linear-gradient(135deg, var(--paaipe-blue), var(--paaipe-navy));
  }
  .lib-card__head--template {
    color: var(--paaipe-navy);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--paaipe-gold) 80%, var(--paaipe-white)),
      var(--paaipe-gold)
    );
  }
  .lib-card__head--video {
    background: radial-gradient(
      circle at 50% 55%,
      color-mix(in srgb, var(--paaipe-blue) 45%, var(--paaipe-navy)),
      var(--paaipe-navy-deep) 75%
    );
  }

  .lib-card__icon {
    width: 52px;
    height: 52px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.9;
  }
  .lib-card__play {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--paaipe-white);
    box-shadow: var(--shadow-md);
  }
  .lib-card__play::after {
    content: '';
    position: absolute;
    inset: 0;
    width: 18px;
    height: 20px;
    margin: auto;
    transform: translateX(2px);
    background: var(--paaipe-navy);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  /* The pills wrap rather than overlap, at any card width and any text zoom. */
  .lib-card__pills {
    position: absolute;
    inset: var(--space-3) var(--space-3) auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .lib-card__status,
  .lib-card__medium {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 2px var(--space-3);
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-bold);
    line-height: 1.5;
  }
  .lib-card__status--published {
    background: var(--color-status-success);
    color: var(--paaipe-white);
  }
  .lib-card__status--coming-soon {
    background: var(--paaipe-white);
    color: var(--color-status-warning);
  }
  .lib-card__status--members-only {
    background: var(--paaipe-white);
    color: var(--paaipe-navy);
  }
  .lib-card__status--sample {
    background: var(--paaipe-white);
    color: var(--paaipe-ink);
  }
  /* Solid enough that white text reads on every head, the gold one included. */
  .lib-card__medium {
    background: rgba(3, 13, 31, 0.72);
    color: var(--paaipe-white);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .lib-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6) var(--space-6);
  }
  .lib-card__body > :global(*) {
    margin: 0;
  }
  .lib-card__detail {
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }
  .lib-card__description {
    flex: 1;
  }
  .lib-card__topic {
    align-self: flex-start;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background: var(--paaipe-surface);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-heading);
  }
  .lib-card__foot {
    padding-block-start: var(--space-1);
  }
  .lib-card__foot :global(.btn) {
    width: 100%;
  }
  .lib-card__unavailable {
    margin: 0;
    padding-block-start: var(--space-3);
    border-block-start: 1px dashed var(--color-border-subtle);
    font-size: var(--text-label);
    color: var(--color-text-secondary);
  }
</style>
