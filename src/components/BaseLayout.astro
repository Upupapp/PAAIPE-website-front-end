---
/**
 * The global public shell.
 *
 * Landmark order is: skip link, announcement region, header (with primary nav),
 * main, footer. Every navigation link is a real `<a href>` in the initial HTML,
 * so the site works with JavaScript disabled.
 */
import '../styles/global.css';
import AnnouncementBar from './shell/AnnouncementBar.astro';
import PublicFooter from './shell/PublicFooter.astro';
import PublicHeader from './shell/PublicHeader.astro';
import { ORGANIZATION } from '../content';

interface Props {
  title: string;
  description?: string;
  /** Social preview copy. Tab 14 owns the full metadata system. */
  openGraph?: { title: string; description: string };
  /** Placeholder and internal routes must not be indexed. */
  noindex?: boolean;
  /** Set on the branded 404 and other bare screens. */
  chrome?: boolean;
}

const { title, description, openGraph, noindex = false, chrome = true } = Astro.props;
---

<!doctype html>
<html lang="en-PH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {
      openGraph && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={ORGANIZATION.name} />
          <meta property="og:title" content={openGraph.title} />
          <meta property="og:description" content={openGraph.description} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={openGraph.title} />
          <meta name="twitter:description" content={openGraph.description} />
        </>
      )
    }
    <meta name="application-name" content={ORGANIZATION.acronym} />
    {
      /* Set before first paint so the enhanced layout never flashes the
        no-JS one. Kept to a single class toggle deliberately. */
    }
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    {chrome && <AnnouncementBar />}
    {chrome && <PublicHeader />}

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    {chrome && <PublicFooter />}

    <script>
      import '../scripts/shell';
    </script>
  </body>
</html>
