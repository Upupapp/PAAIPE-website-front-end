---
import BaseLayout from './BaseLayout.astro';
import Callout from './ui/Callout.astro';
import Container from './ui/Container.astro';
import PageHero from './ui/PageHero.astro';
import { findRoute } from '../config/routes';

interface Props {
  route: string;
}

const { route: routePath } = Astro.props;
const route = findRoute(routePath);
---

<BaseLayout
  title={route.title}
  description={route.description}
  openGraph={route.openGraph}
  noindex={route.placeholderOnly}
>
  <PageHero heading={route.heading} />
  <Container>
    <div class="route-body">
      <Callout tone="info" title={`Implemented in ${route.ownedBy}`}>
        <p>
          Route scaffold. The content of this page is implemented in {route.ownedBy} of the PAAIPE Frontend
          Master Command. No approved copy beyond the heading is present yet.
        </p>
      </Callout>
      <slot />
    </div>
  </Container>
</BaseLayout>
