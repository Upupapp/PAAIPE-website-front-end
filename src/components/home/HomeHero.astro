---
/**
 * Hero. The H1, body, supporting line and both CTAs are in the initial HTML and
 * operable before any script runs - nothing here waits on JavaScript.
 *
 * The decorative composition sits behind the copy, is aria-hidden, and is
 * separate from the official logo.
 */
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import ExternalAction from '../ui/ExternalAction.astro';
import NetworkField from '../decor/NetworkField.astro';
import PhilippineContour from '../decor/PhilippineContour.astro';
import { HOME_HERO } from '../../content';
---

<section class="hero has-decor" aria-labelledby="hero-heading">
  {
    /*
     * The contour rides in NetworkField's `map` slot, which has been an empty
     * seam since Tab 02 (B-6). It is on the HOME hero only: the master command
     * asks for it as part of the decor, and repeating it behind every page
     * heading would make a background motif into a recurring statement.
     */
  }
  <NetworkField tone="on-dark">
    <PhilippineContour slot="map" />
  </NetworkField>
  <Container>
    <div class="hero__body">
      <p class="hero__eyebrow" data-enter="eyebrow">{HOME_HERO.eyebrow}</p>
      <h1 class="hero__heading" id="hero-heading" data-enter="title">{HOME_HERO.heading}</h1>
      <p class="hero__lead" data-enter="lead">{HOME_HERO.body}</p>
      <div class="hero__actions" data-enter="actions">
        <ExternalAction
          action="membership-application"
          label={HOME_HERO.primaryCta}
          variant="primary"
          size="lg"
          onDark
        />
        <Button as="a" href="/about" variant="secondary" size="lg" onDark>
          {HOME_HERO.secondaryCta}
        </Button>
      </div>
      <p class="hero__supporting" data-enter="actions">{HOME_HERO.supportingLine}</p>
    </div>
  </Container>
</section>

<style>
  .hero {
    padding-block: var(--space-20) var(--space-16);
    background: var(--color-surface-inverse-deep);
    color: var(--color-text-inverse);
    overflow: hidden;
  }
  .hero__body {
    display: grid;
    gap: var(--space-5);
    max-width: 46rem;
  }
  /*
   * A GRID ITEM'S DEFAULT `min-width: auto` IS A FLOOR, NOT A PREFERENCE.
   *
   * Without this, the column cannot get narrower than the widest item's
   * min-content - here the action row, whose buttons will not wrap their
   * labels. MEASURED on iPhone 13 (390px) at 200% text zoom: the column sized
   * to 418px and every sibling stretched to match, so the heading, the lead
   * paragraph and both actions ran 48px past the viewport.
   *
   * It did NOT show up as a horizontal scrollbar, because `.hero` sets
   * `overflow: hidden` - the 48px was silently CLIPPED. That is the worse
   * failure of the two: a scrollbar at least tells you something is off-screen,
   * and an automated "does the page scroll sideways" check passes while the
   * content is gone. `tests/e2e/journeys.spec.ts` now asserts on clipped
   * content as well as on document overflow.
   */
  .hero__body > * {
    min-width: 0;
  }
  .hero__eyebrow {
    margin: 0;
    font-size: var(--text-caption);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    color: var(--color-text-accent-on-dark);
  }
  .hero__heading {
    margin: 0;
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    color: var(--color-text-inverse);
  }
  .hero__lead {
    margin: 0;
    font-size: var(--text-body-lg);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-4);
    margin-block-start: var(--space-2);
  }
  .hero__supporting {
    margin: 0;
    color: var(--color-text-accent-on-dark);
    font-weight: var(--font-weight-semibold);
  }
</style>
