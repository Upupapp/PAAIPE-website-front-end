---
/**
 * The site header: logo lockup, primary navigation, persistent actions.
 *
 * Sticky, but deliberately constrained:
 *  - it keeps a FIXED height and only compacts its padding and shadow, so it
 *    cannot shift layout or resize the logo erratically;
 *  - `scroll-padding-top` on the document keeps it from covering an element
 *    that has just received focus (WCAG 2.4.11).
 */
import LogoLockup from '../LogoLockup.astro';
import ResponsiveNavigation from './ResponsiveNavigation.astro';
import { ORGANIZATION } from '../../content';

// See ResponsiveNavigation: `.html` must be stripped, or `/index.html` is
// never recognised as the home page.
---

<header class="site-header" data-site-header transition:persist="site-header">
  <div class="site-header__inner">
    {
      /*
       * The brand link does NOT claim aria-current.
       *
       * On the home page it and the nav's "Home" link both pointed at `/` and
       * both announced themselves as the current page. Two elements claiming
       * that is ambiguous: a screen reader announces "current page" twice, for
       * one page, and neither is more authoritative than the other.
       *
       * The nav link is the right one to keep — it sits inside the navigation
       * landmark, where "which page am I on" is the question being asked. A
       * masthead logo is a shortcut home, not a nav item, and it carries the
       * organisation name as its accessible name rather than a page name.
       *
       * Nothing else needed `isHome`, so it is gone. The comment that first
       * replaced this claimed it "still drives the heading level below" — it
       * did not, and lint said so immediately.
       */
    }
    <a class="site-header__brand" href="/">
      {
        /* Decorative: the visually hidden name beside it already identifies the
          organisation, so repeating it in alt would double the announcement. */
      }
      {
        /*
         * One image, four rendered sizes, all derived from the same source
         * measurements. A 64px mobile header cannot hold a 196px logo - it is
         * 68px tall on its own - so a single width forces either an overheight
         * header or a distorted mark. Never lazy-loaded: it is the LCP element.
         */
      }
      <LogoLockup
        variant="horizontal"
        width={132}
        widths={[146, 168, 188]}
        align="optical"
        decorative
        priority
      />
      <span class="sr-only">{ORGANIZATION.name} — home</span>
    </a>

    <button
      type="button"
      class="site-header__toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Open navigation"
      hidden
    >
      {
        /*
         * The accessible name is an `aria-label` that CHANGES with the state,
         * not a static "Menu". A control whose name never changes tells a
         * screen-reader user what the thing is but not what pressing it will
         * do — and "Menu" is the same word whether it is about to open or
         * close. `aria-expanded` carries the state; the label carries the
         * action. `src/scripts/shell.ts` swaps it.
         */
      }
      <span class="site-header__burger" aria-hidden="true"></span>
    </button>

    <ResponsiveNavigation />
  </div>

  <div class="site-header__overlay" data-nav-overlay hidden></div>
</header>

<style>
  .site-header {
    z-index: 50;
    background: var(--color-surface-raised);
    border-block-end: 1px solid var(--color-border-subtle);
    transition: box-shadow var(--motion-fast) var(--ease-standard);
  }

  /* Sticky only once script has enhanced the page. Without JavaScript the
     drawer cannot open, so the navigation renders inline INSIDE the header -
     and a sticky container holding the full nav covers most of a 390px screen
     and intercepts taps on the content beneath it. Static is correct there. */
  :global(html.js) .site-header {
    position: sticky;
    inset-block-start: 0;
    background: transparent;
  }
  .site-header.is-compact {
    box-shadow: var(--shadow-sm);
  }

  /*
   * THE FROSTED BAR - the owner's header layout, 2026-09-15 (F-76).
   *
   * The translucency lives on a PSEUDO-ELEMENT, never on the header itself.
   * `backdrop-filter` on an element makes it the containing block for every
   * `position: fixed` descendant, and the mobile drawer and its overlay ARE
   * fixed descendants of this header. Filter the header and the drawer is
   * confined to the header's own strip instead of the viewport.
   *
   * Only once script has made the header sticky: a static header never has
   * content scrolling beneath it, so there is nothing to see through, and it
   * keeps the solid surface above. The sticky header is a positioned stacking
   * context (z-index 50), which is what lets `z-index: -1` sit behind its content
   * and still above the page.
   */
  :global(html.js) .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(255, 255, 255, 0.86);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  /* Without a backdrop filter, 14% of whatever scrolls beneath shows through
     unblurred - noise behind the links. Solid is the honest fallback. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    :global(html.js) .site-header::before {
      background: var(--color-surface-raised);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    :global(html.js) .site-header::before {
      background: var(--color-surface-raised);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /*
   * NAMED ONLY WHILE A VIEW TRANSITION RUNS.
   *
   * `view-transition-name` makes an element a BACKDROP ROOT: a backdrop-filter
   * inside it samples only what the element itself paints, never the page
   * behind. This header carried `transition:name` permanently, so the frosted
   * bar above blurred NOTHING - while every computed style still read
   * `blur(14px)`. Measured across the top edge of the navy section, one pixel
   * column went 254 -> 225 in a single step; with the name absent it went
   * 251 -> 227 over 18 steps (F-76).
   *
   * The name exists so the header stays put during a client-side navigation
   * (motion.css gives `site-header` no animation). It only has to exist while a
   * transition captures and plays, so it is scoped to `:active-view-transition`,
   * which Chromium, Firefox and WebKit all support. `transition:persist` keeps an
   * explicit id, so persistence no longer depends on the name.
   *
   * Moving the name to the inner row instead was tried and REJECTED on
   * measurement: the row became a stacking context beneath the drawer overlay,
   * and a tap on a drawer link landed on the overlay.
   */
  :global(html:active-view-transition) .site-header {
    view-transition-name: site-header;
  }

  /*
   * ONE ROW, ONE CENTRELINE.
   *
   * This was `display: flex; justify-content: space-between` around a <nav>
   * that wrapped internally, so the brand, the links and the actions each sat
   * on a different line: measured at 1920px, their top edges were 97px, 56px
   * and 120px, in a 165px header.
   *
   * A grid fixes the columns. `minmax(0, 1fr)` on the middle column is the part
   * that matters - a bare `1fr` has an automatic minimum of the content's
   * min-content width, so a long navigation would push the actions out of the
   * container instead of the column simply becoming narrower.
   *
   * The nav's own box is dissolved at this breakpoint (see
   * ResponsiveNavigation), so the link list and the actions ARE columns two and
   * three rather than being nested inside one.
   */
  .site-header__inner {
    width: 100%;
    max-width: var(--width-content);
    margin-inline: auto;
    padding-block: var(--space-2);
    padding-inline: clamp(20px, 4vw, 48px);
    display: grid;
    /*
     * Two columns: brand, then the navigation. The nav lays out its own links
     * and actions as one flex row - see ResponsiveNavigation for why it keeps
     * its box rather than dissolving into a third grid column.
     *
     * `minmax(0, 1fr)` matters: a bare `1fr` has an automatic minimum of the
     * content's min-content width, so a long navigation would push past the
     * container instead of the column simply becoming narrower.
     */
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(20px, 2.5vw, 40px);
    /* Mobile: the whole header row. */
    min-height: 64px;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  .site-header__brand:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .site-header__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .site-header__toggle:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-text-heading);
    border-radius: 2px;
  }
  .site-header__burger::before,
  .site-header__burger::after {
    content: '';
    position: relative;
  }
  .site-header__burger::before {
    inset-block-start: -6px;
  }
  .site-header__burger::after {
    inset-block-start: 4px;
  }

  .site-header__overlay {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgba(3, 13, 31, 0.55);
  }

  /* Tablet: the links are in the panel, so the row is brand + toggle. */
  @media (min-width: 48rem) {
    .site-header__inner {
      min-height: 72px;
    }
  }

  /*
   * 74em = 1184px, and it is MEASURED, not chosen for tidiness.
   *
   * The desktop row needs 1215px of viewport: brand 170 + gap 40 + links 670 +
   * gap 40 + links 614 + gap 28 + actions 199, plus 96 of padding = 1147px. At
   * the old 64em (1024px) it did not fit, and because the links and actions must
   * never shrink, the overflow spilled LEFT out of the nav and painted the logo
   * over "Home" - the header looked fine and was silently broken.
   *
   * Switching modes BEFORE anything wraps or overlaps is the requirement, so the
   * breakpoint sits 37px above the measured need. It is also bounded above by
   * the shared site container (72rem = 1152px): the row must fit inside that, not
   * inside the viewport, which is why widening the viewport alone never helped.
   */
  @media (min-width: 74em) {
    .site-header__inner {
      /*
       * 80px, and it does not move. The announcement above is 44px, so the
       * header a visitor meets is 124px - the ceiling the brief sets - and it
       * scrolls away, leaving 80px sticky. The owner's header layout
       * (2026-09-15, F-76) drew an 86px bar; the owner then chose to keep this
       * ceiling, so the frosted bar is 80px. The document's scroll offsets in
       * global.css are derived from this number.
       */
      min-height: 80px;
    }

    /* Above the breakpoint the nav is inline, so the toggle and overlay have
       no job. Hiding them also removes the toggle from the tab order. */
    .site-header__toggle,
    .site-header__overlay {
      display: none !important;
    }
  }

  /*
   * Below the breakpoint the nav lives in the drawer, so the header row is
   * brand + toggle: two columns, not three. Without this the empty third
   * column still claims its share of the gap and pulls the toggle inward.
   */
  @media (max-width: 73.999em) {
    .site-header__inner {
      grid-template-columns: auto 1fr;
    }
    .site-header__toggle {
      justify-self: end;
    }
  }
</style>
