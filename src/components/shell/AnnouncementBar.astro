---
/**
 * Optional, data-driven announcement bar.
 *
 * It carries only the approved recurring-session line. No meeting link, no
 * unapproved speaker or date, and no countdown or urgency language.
 *
 * Progressive enhancement: the bar and its text are in the initial HTML. The
 * dismiss button is `hidden` in markup and revealed by script, so with
 * JavaScript disabled there is no control that does nothing.
 */
import { SIGNATURE_EVENT } from '../../content';

interface Props {
  /** Omit to render nothing at all - the bar is genuinely optional. */
  message?: string;
  dismissible?: boolean;
}

const { message = SIGNATURE_EVENT.announcementBar, dismissible = true } = Astro.props;
---

{
  message && (
    <div
      class="announcement"
      id="announcement"
      data-dismissible={dismissible ? 'true' : undefined}
      transition:persist
    >
      {/*
       * A region, not an aria-live area: this is static at page load, and a
       * live region would announce it over whatever the user is reading.
       *
       * The brief asks for `role="region"` and `aria-label="Announcement"`.
       * A `<section>` WITH an accessible name already has role=region
       * natively, so writing the role as well is redundant markup that
       * html-validate refuses. The requirement is met — the computed role is
       * `region` and the accessible name is "Announcement", measured in
       * Chromium and WebKit rather than assumed — so only the redundant
       * attribute is dropped, not the semantics.
       */}
      <section class="announcement__inner" aria-label="Announcement">
        <p class="announcement__text">
          {message}{' '}
          <a class="announcement__link" href={SIGNATURE_EVENT.announcementLinkHref}>
            {SIGNATURE_EVENT.announcementLinkLabel}
          </a>
        </p>
        {dismissible && (
          <button
            type="button"
            class="announcement__close"
            data-announcement-close
            aria-label="Dismiss announcement"
            hidden
          >
            <span aria-hidden="true">×</span>
          </button>
        )}
      </section>
    </div>
  )
}

<style>
  .announcement {
    background: var(--color-surface-inverse-deep);
    color: var(--color-text-inverse);
  }
  .announcement__inner {
    /*
     * THE BAR MUST BE THE SAME SHAPE BEFORE AND AFTER ENHANCEMENT.
     *
     * The dismiss button ships `hidden` and is revealed by script. When it was
     * a flex item, revealing it changed the bar in two ways at once:
     *
     *   - HEIGHT: the button is a 44px touch target, taller than the text row,
     *     so the bar grew 21px and pushed the whole page down.
     *   - ALIGNMENT: `margin-inline-start: auto` on the button absorbed all the
     *     free space, which left `justify-content: center` nothing to
     *     distribute - so the text stopped being centred and snapped left.
     *
     * MEASURED on the home page: a single layout shift of **0.200**, twice the
     * 0.1 Core Web Vitals threshold, at 29ms after load. Lighthouse reported
     * CLS 0.000, because its run did not reach the state that shifts.
     *
     * The fix is to take the button out of flow and reserve its space
     * unconditionally: the geometry is now identical with JavaScript on or off.
     */
    position: relative;
    width: 100%;
    max-width: var(--width-content);
    margin-inline: auto;
    /* 44px of clear space at both ends, so the centred text is never covered
       by the button and stays centred whether or not it is shown. */
    padding: var(--space-2) 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }
  .announcement__text {
    margin: 0;
    max-width: none;
    font-size: var(--text-caption);
    text-align: center;
    /* The bar may wrap to two lines on a phone; it must never truncate. */
    text-wrap: pretty;
  }

  /*
   * A real link to a real page, not a decorated span. Underlined rather than
   * relying on the accent colour, because this sits on a dark surface where
   * colour alone is the weakest of the available signals.
   */
  .announcement__link {
    color: var(--color-text-accent-on-dark);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }
  .announcement__link:hover {
    color: var(--color-text-inverse);
  }
  .announcement__link:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }
  .announcement__close {
    /* Out of flow: revealing it must not move anything. */
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    /* 44px target even though the glyph is small. */
    width: 44px;
    height: 44px;
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    color: inherit;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
  .announcement__close:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .announcement__close:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: calc(var(--focus-ring-offset) * -1);
  }
  @media (min-width: 48rem) {
    .announcement__inner {
      /* Still never less than the 44px the button occupies. */
      padding-inline: max(var(--space-8), 44px);
    }
  }
</style>
