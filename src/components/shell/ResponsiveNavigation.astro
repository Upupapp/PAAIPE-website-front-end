---
/**
 * Primary navigation. One markup tree serves both layouts.
 *
 * Above 64em it is a horizontal nav. Below, the same list becomes a drawer -
 * but it is present in the initial HTML either way, so with JavaScript disabled
 * every link is still reachable as a plain stacked list (see the `:root:not(.js)`
 * rules). No control is rendered that would do nothing.
 *
 * Grouped items render their parent AND their children as real links, so a
 * dropdown never becomes the only route to a page.
 */
import { primaryNav } from '../../content';
import { currentPath } from '../../lib/current-path';
import HeaderActions from './HeaderActions.astro';

/*
 * `.html` is stripped before comparing.
 *
 * `build.format: 'file'` emits `about.html`, so during static generation
 * `Astro.url.pathname` is `/about.html` — not `/about`. Every comparison
 * against the route registry silently failed, and the result was that
 * `aria-current="page"` was absent from EVERY page on the site: no visual
 * current-page indicator, and nothing for a screen reader to announce.
 *
 * The format change was made to remove a 301 on every internal link. It was
 * correct, and this was its cost, unnoticed because only one narrow test
 * happened to cover it.
 */
const pathname = currentPath(Astro.url.pathname);

/** Exact match, or an ancestor of the current path (so /events/x lights Events). */
function isCurrent(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}

function groupIsCurrent(href: string, children: readonly { href: string }[] | undefined): boolean {
  return isCurrent(href) || (children ?? []).some((child) => isCurrent(child.href));
}

/**
 * Exactly one link may claim aria-current="page". A group parent yields to a
 * child that matches the URL more specifically, and takes the group indicator
 * instead - two elements announcing "current page" is ambiguous.
 */
function parentIsCurrentPage(item: (typeof primaryNav)[number]): boolean {
  if (!isCurrent(item.href)) return false;
  return !(item.children ?? []).some((child) => child.href !== item.href && isCurrent(child.href));
}
---

<nav id="primary-navigation" class="nav" aria-label="Primary">
  <ul class="nav__list">
    {
      primaryNav.map((item) => (
        <li class:list={['nav__item', item.children && 'nav__item--group']}>
          <a
            class="nav__link"
            href={item.href}
            aria-current={parentIsCurrentPage(item) ? 'page' : undefined}
            data-current-group={groupIsCurrent(item.href, item.children) ? 'true' : undefined}
          >
            {item.label}
          </a>
          {item.children && (
            <ul class="nav__sub">
              {item.children.map((child) => (
                <li>
                  <a
                    class="nav__sublink"
                    href={child.href}
                    aria-current={
                      child.href !== item.href && isCurrent(child.href) ? 'page' : undefined
                    }
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>

  <div class="nav__actions">
    <HeaderActions />
  </div>
</nav>

<style>
  .nav__list,
  .nav__sub {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }

  .nav__link,
  .nav__sublink {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-heading);
    font-size: var(--text-label);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .nav__link:hover,
  .nav__sublink:hover {
    background: var(--paaipe-surface);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .nav__link:focus-visible,
  .nav__sublink:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  /* Active route: an underline bar AND aria-current. Never colour alone. */
  .nav__link[aria-current='page'],
  .nav__sublink[aria-current='page'],
  .nav__link[data-current-group='true'] {
    color: var(--paaipe-navy);
    box-shadow: inset 0 -3px 0 0 var(--paaipe-blue);
  }

  .nav__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* ---------- Mobile / no-JS: a plain stacked list ---------- */
  .nav {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .nav__list {
    display: grid;
    gap: var(--space-1);
  }
  .nav__sub {
    display: grid;
    gap: var(--space-1);
    padding-inline-start: var(--space-4);
    border-inline-start: 1px solid var(--color-border-subtle);
    margin-block-start: var(--space-1);
  }
  .nav__sublink {
    font-weight: var(--font-weight-regular);
    color: var(--color-text-secondary);
  }

  /* ---------- Mobile drawer, only once script has enhanced the page ------ */
  :global(html.js) .nav {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    z-index: 60;
    width: min(22rem, 88vw);
    padding: var(--space-6);
    overflow-y: auto;
    background: var(--color-surface-raised);
    border-inline-start: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-lg);
    transform: translateX(100%);
    visibility: hidden;
    /* visibility is DELAYED on close so the slide-out stays visible, and flips
       INSTANTLY on open below. Transitioning it symmetrically leaves the drawer
       visibility:hidden while it slides in, and focus() on a hidden element
       silently does nothing - the menu opens with focus still on the toggle. */
    transition:
      transform var(--motion-drawer) var(--ease-standard),
      visibility 0s linear var(--motion-drawer);
  }

  :global(html.js[data-nav-open='true']) .nav {
    transform: translateX(0);
    visibility: visible;
    transition:
      transform var(--motion-drawer) var(--ease-standard),
      visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .nav,
    :global(html.js[data-nav-open='true']) .nav {
      transition: none;
    }
  }

  /* ---------- Desktop ---------- */
  /*
   * 74em = 1184px, and it is MEASURED, not chosen for tidiness.
   *
   * The desktop row needs 1215px of viewport: brand 170 + gap 40 + links 670 +
   * gap 40 + links 614 + gap 28 + actions 199, plus 96 of padding = 1147px. At
   * the old 64em (1024px) it did not fit, and because the links and actions must
   * never shrink, the overflow spilled LEFT out of the nav and painted the logo
   * over "Home" - the header looked fine and was silently broken.
   *
   * Switching modes BEFORE anything wraps or overlaps is the requirement, so the
   * breakpoint sits 37px above the measured need. It is also bounded above by
   * the shared site container (72rem = 1152px): the row must fit inside that, not
   * inside the viewport, which is why widening the viewport alone never helped.
   */
  @media (min-width: 74em) {
    /*
     * A FLEX ROW, not `display: contents`.
     *
     * `display: contents` would have let the link list and the actions become
     * grid items of the header directly, which is tidier. It was tried and
     * REJECTED on measurement: with the nav box dissolved, Playwright's role
     * engine reported `navigation[name="Primary"]` as absent in both Chromium
     * and WebKit. axe's region rule did not object, which is exactly why the
     * two were cross-checked — an element that generates no box is not reliably
     * exposed as a landmark, and a landmark that cannot be proven present is
     * not one to ship.
     *
     * So the <nav> keeps its box and lays its own children out. Same single
     * row, same centreline, landmark intact.
     */
    .nav,
    :global(html.js) .nav {
      position: static;
      inset: auto;
      width: auto;
      min-width: 0;
      padding: 0;
      overflow: visible;
      background: none;
      border: 0;
      box-shadow: none;
      transform: none;
      visibility: visible;
      transition: none;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      /* NOWRAP at every level: the row is one row or the breakpoint hands over
         to the disclosure panel. It never becomes two rows. */
      flex-wrap: nowrap;
      /*
       * The gutter between the links and the actions. Tighter than the header's
       * own column gap because it is an internal separation, not a structural
       * one - and because the shared site container is 1152px, so every pixel
       * spent here is a pixel the links cannot have.
       */
      gap: clamp(16px, 2vw, 28px);
    }

    /* The actions do not shrink either, for the same reason. */
    .nav__actions {
      flex: none;
    }

    .nav__list {
      display: flex;
      align-items: center;
      /*
       * NOWRAP. An individual navigation label must never wrap or truncate, and
       * the row must never become two rows. When the links genuinely stop
       * fitting, the breakpoint below hands over to the disclosure panel -
       * which is the honest answer, rather than reflowing into a taller header.
       */
      flex-wrap: nowrap;
      gap: clamp(0.25rem, 1.2vw, 0.75rem);
      /*
       * NEVER SHRINK. `min-width: 0` here let the list compress below its own
       * content while the labels stayed `nowrap`, so the links overflowed their
       * box and the actions painted on top of them - "Partners" sat underneath
       * the membership button at 1920px.
       *
       * A navigation label must never be squeezed, truncated or wrapped. If the
       * row genuinely stops fitting, that is what the breakpoint is for.
       */
      flex: none;
    }

    .nav__item--group {
      position: relative;
    }
    .nav__sub {
      position: absolute;
      inset-block-start: 100%;
      inset-inline-start: 0;
      z-index: 40;
      min-width: 14rem;
      margin: 0;
      padding: var(--space-2);
      background: var(--color-surface-raised);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-md);
      /* Hidden with clip, not display:none, so it stays keyboard reachable
         and opens on focus-within as well as hover. */
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
      transition:
        opacity var(--motion-menu) var(--ease-standard),
        transform var(--motion-menu) var(--ease-standard),
        visibility var(--motion-menu);
    }
    .nav__item--group:hover .nav__sub,
    .nav__item--group:focus-within .nav__sub {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .nav__sublink {
      color: var(--color-text-heading);
    }

    .nav__link {
      /*
       * 44px usable hit HEIGHT with tighter horizontal padding.
       *
       * The target stays 44px tall - the requirement is a usable hit area, and
       * the row is 80px, so height is where that is won. Horizontally, 8px each
       * side plus the 12px list gap puts ~28px between labels, the top of the
       * brief's 20-28px range, and returns 56px to the row.
       */
      min-height: 44px;
      padding-inline: var(--space-2);
      white-space: nowrap;
      font-size: var(--text-label);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__sub {
      transition: none;
    }
  }
</style>
