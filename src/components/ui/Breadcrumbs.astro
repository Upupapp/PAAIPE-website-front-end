---
/** Labelled breadcrumb nav. The current item is text, not a link, and carries aria-current. */
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, index) => (
        <li>
          {item.href && index < items.length - 1 ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
          {index < items.length - 1 && (
            <span class="breadcrumbs__sep" aria-hidden="true">
              /
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    max-width: none;
    font-size: var(--text-caption);
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-width: none;
  }
  .breadcrumbs a {
    color: var(--color-link);
  }
  .breadcrumbs [aria-current='page'] {
    color: var(--color-text-secondary);
  }
  .breadcrumbs__sep {
    color: var(--color-border-control);
  }
</style>
