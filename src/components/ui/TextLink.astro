---
/**
 * Inline link. Underlined always: colour alone never carries the fact that
 * something is a link. External links are marked visibly and programmatically.
 */
interface Props {
  href: string;
  external?: boolean;
  onDark?: boolean;
  class?: string;
}
const { href, external = false, onDark = false, class: className } = Astro.props;
---

<a
  class:list={['text-link', onDark && 'text-link--on-dark', className]}
  href={href}
  rel={external ? 'noopener noreferrer' : undefined}
  target={external ? '_blank' : undefined}
>
  <slot />
  {
    external && (
      <>
        <span aria-hidden="true">↗</span>
        <span class="sr-only">(opens in a new tab)</span>
      </>
    )
  }
</a>

<style>
  .text-link {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 0.08em;
    border-radius: var(--radius-xs);
  }
  .text-link:hover {
    text-decoration-thickness: 0.14em;
  }
  .text-link:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
  .text-link--on-dark {
    color: var(--paaipe-white);
  }
</style>
