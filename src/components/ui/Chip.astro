---
/**
 * Filter chip. Selected state uses fill, a check glyph AND aria-pressed -
 * never colour alone.
 */
interface Props {
  selected?: boolean;
  name?: string;
  value?: string;
  class?: string;
}
const { selected = false, name, value, class: className } = Astro.props;
---

<button
  type="button"
  class:list={['chip', selected && 'chip--selected', className]}
  aria-pressed={selected ? 'true' : 'false'}
  data-name={name}
  data-value={value}
>
  {
    selected && (
      <span class="chip__check" aria-hidden="true">
        ✓
      </span>
    )
  }
  <slot />
</button>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    cursor: pointer;
  }
  .chip--selected {
    background: var(--paaipe-navy);
    color: var(--paaipe-white);
    border-color: var(--paaipe-navy);
  }
  .chip:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-ring-offset);
  }
</style>
