---
/**
 * Page hero. The H1, its supporting copy and any CTA are in the initial HTML
 * and operable before script runs; the decorative field sits behind them and
 * carries no information.
 *
 * Two optional named slots, rendered only when a page fills them, so every
 * other hero's markup is exactly what it was:
 *  - `aside`: an illustration beside the copy from 60em, below it when narrow;
 *  - `edge`: a shape along the hero's bottom edge, over a white-to-page wash.
 * Both are decorative, and the page marks them aria-hidden. First used by the
 * owner's Resources layout (2026-09-15, F-77).
 */
import NetworkField from '../decor/NetworkField.astro';
import Container from './Container.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  tone?: 'light' | 'dark';
  decor?: boolean;
}
const { eyebrow, heading, tone = 'light', decor = true } = Astro.props;
const hasAside = Astro.slots.has('aside');
const hasEdge = Astro.slots.has('edge');
---

<section
  class:list={['page-hero', `page-hero--${tone}`, decor && 'has-decor', hasEdge && 'has-edge']}
>
  {decor && <NetworkField tone={tone === 'dark' ? 'on-dark' : 'on-light'} />}
  <Container>
    {
      hasAside ? (
        <div class="page-hero__split">
          <div class="page-hero__body">
            {eyebrow && (
              <p class="page-hero__eyebrow" data-enter="eyebrow">
                {eyebrow}
              </p>
            )}
            <h1 class="page-hero__title" data-enter="title">
              {heading}
            </h1>
            <slot />
          </div>
          <div class="page-hero__aside">
            <slot name="aside" />
          </div>
        </div>
      ) : (
        <div class="page-hero__body">
          {eyebrow && (
            <p class="page-hero__eyebrow" data-enter="eyebrow">
              {eyebrow}
            </p>
          )}
          <h1 class="page-hero__title" data-enter="title">
            {heading}
          </h1>
          <slot />
        </div>
      )
    }
  </Container>
  {
    hasEdge && (
      <div class="page-hero__edge">
        <slot name="edge" />
      </div>
    )
  }
</section>

<style>
  .page-hero {
    padding-block: var(--space-16) var(--space-12);
    overflow: hidden;
  }
  .page-hero--light {
    background: var(--color-surface-page);
  }
  .page-hero--dark {
    background: var(--color-surface-inverse-deep);
    color: var(--color-text-inverse);
  }
  .page-hero__body {
    display: grid;
    gap: var(--space-4);
    max-width: var(--width-prose);
  }
  /*
   * Same floor as HomeHero: a grid item's `min-width: auto` stops the column
   * shrinking below the widest item's min-content. MEASURED on iPhone 13 at
   * 200% text zoom, the hero body sized to 429px inside a 350px content box on
   * /programs and /events, clipping the eyebrow, the H1 and the lead. Five
   * routes were affected; only a per-route sweep at 200% found them, because
   * the amount over depended on the longest word in each heading.
   */
  .page-hero__body > *,
  .page-hero__split > * {
    min-width: 0;
  }
  .page-hero__eyebrow {
    margin: 0;
    font-size: var(--text-caption);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .page-hero--dark .page-hero__eyebrow {
    color: var(--color-text-accent-on-dark);
  }
  .page-hero__title {
    margin: 0;
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
  }
  .page-hero--dark .page-hero__title {
    color: var(--color-text-inverse);
  }

  .page-hero__split {
    display: grid;
    gap: var(--space-10);
    align-items: center;
  }
  @media (min-width: 60em) {
    .page-hero__split {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }

  .page-hero.has-edge {
    position: relative;
    padding-block-end: calc(var(--space-12) + 4.5rem);
  }
  .page-hero--light.has-edge {
    background: linear-gradient(180deg, var(--paaipe-white), var(--color-surface-page));
  }
  /*
   * Three classes, not one: the global `.has-decor > *:not(.network-field)` rule
   * sets every child of a decorated hero to position: relative, and a one-class
   * selector would tie it and lose on source order.
   */
  .page-hero.has-edge > .page-hero__edge {
    position: absolute;
    inset: auto 0 -2px;
    height: 7.5rem;
    pointer-events: none;
  }
  .page-hero__edge > :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
