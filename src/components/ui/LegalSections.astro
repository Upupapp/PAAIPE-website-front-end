---
/**
 * Renders a draft legal page as structure plus visibly unresolved placeholders.
 *
 * Placeholders are shown as bracketed tokens on purpose. Plausible-looking
 * boilerplate is the thing most likely to be published by accident; a page that
 * obviously has holes in it cannot be mistaken for finished legal text.
 */
import type { LegalSection } from '../../content/legal';

interface Props {
  sections: readonly LegalSection[];
}
const { sections } = Astro.props;
const unresolved = sections.reduce((total, section) => total + section.placeholders.length, 0);
---

<p class="legal__count">
  <strong>{unresolved}</strong> values still need to be supplied and approved before this page can be
  published.
</p>

<div class="legal">
  {
    sections.map((section, index) => (
      <section class="legal__section">
        <h2 class="legal__heading">
          <span class="legal__number" aria-hidden="true">
            {index + 1}
          </span>
          {section.heading}
        </h2>
        <p class="legal__summary">{section.summary}</p>
        {section.placeholders.length > 0 && (
          <ul class="legal__placeholders">
            {section.placeholders.map((placeholder) => (
              <li>
                <span class="sr-only">Unresolved value: </span>
                <code>[{placeholder}]</code>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</div>

<style>
  .legal__count {
    margin: var(--space-8) 0 0;
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface-raised);
    border: 1px dashed var(--color-border-control);
    border-radius: var(--radius-md);
    max-width: var(--width-prose);
  }
  .legal {
    display: grid;
    gap: var(--space-8);
    margin-block-start: var(--space-8);
    max-width: var(--width-prose);
  }
  .legal__heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0 0 var(--space-2);
    font-size: var(--text-h4);
  }
  .legal__number {
    font-size: var(--text-caption);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-secondary);
  }
  .legal__summary {
    margin: 0;
    color: var(--color-text-secondary);
  }
  .legal__placeholders {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    max-width: none;
  }
  .legal__placeholders li {
    max-width: none;
  }
  .legal__placeholders code {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background: var(--color-disabled-surface);
    border: 1px dashed var(--color-status-warning);
    border-radius: var(--radius-xs);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--text-caption);
    color: var(--color-status-warning);
  }
</style>
