---
/**
 * FAQ accordion built on native `<details>` / `<summary>`.
 *
 * Deliberately not a custom widget. `<details>` is keyboard-operable, exposes
 * the right expanded state to assistive technology, and works with JavaScript
 * disabled - all of which a hand-rolled accordion has to reimplement and
 * usually gets partly wrong. Content is in the DOM either way, so a browser's
 * find-in-page can reach it.
 *
 * Only the chevron animates, and it is static under reduced motion.
 */
import type { Faq } from '../../content/types';

interface Props {
  items: readonly Faq[];
  /** Distinguishes multiple accordions on one page. */
  name?: string;
}
const { items, name = 'faq' } = Astro.props;
---

<div class="accordion">
  {
    items.map((item) => (
      <details class="accordion__item" name={name} id={`${name}-${item.slug}`}>
        <summary class="accordion__summary">
          <span class="accordion__question">{item.question}</span>
          <span class="accordion__chevron" aria-hidden="true" />
        </summary>
        <div class="accordion__answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .accordion {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
  }
  .accordion__item {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    scroll-margin-top: 96px;
  }
  .accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    /* 44px minimum target. */
    min-height: 44px;
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    list-style: none;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-heading);
  }
  /* Replace the default disclosure triangle with our own chevron. */
  .accordion__summary::-webkit-details-marker {
    display: none;
  }
  .accordion__summary::marker {
    content: '';
  }
  .accordion__summary:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring);
    outline-offset: calc(var(--focus-ring-offset) * -1);
    border-radius: var(--radius-md);
  }
  .accordion__question {
    max-width: var(--width-prose);
  }
  .accordion__chevron {
    flex: none;
    width: 12px;
    height: 12px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 180ms cubic-bezier(0.2, 0, 0, 1);
  }
  .accordion__item[open] .accordion__chevron {
    transform: rotate(-135deg) translate(-2px, -2px);
  }
  .accordion__answer {
    padding: 0 var(--space-5) var(--space-5);
  }
  .accordion__answer p {
    margin: 0;
    color: var(--color-text-secondary);
  }
  @media (prefers-reduced-motion: reduce) {
    .accordion__chevron {
      transition: none;
    }
  }
</style>
