---
/**
 * The event marketplace, Tab 03.
 *
 * SERVER-RENDERED FIRST. Every publishable event is in the HTML before any
 * script runs, so the page is useful without JavaScript - the command's rule,
 * and the only way a static site can honestly claim it. The search, filters and
 * sort are an ENHANCEMENT that hides and reorders what is already there; with
 * scripting off, nothing is hidden and the full list stands.
 *
 * ONE RESOLVER decides what each event offers. Cards do not reproduce state
 * logic, so a card cannot say "Register" beside a detail page that says
 * "Registration closed".
 *
 * NOTHING IS INVENTED. No seats remaining, no attendance, no "Trending", no
 * countdown: the record has no field for any of them, so the page has no way to
 * render one.
 */
import BaseLayout from '../../components/BaseLayout.astro';
import HomeSection from '../../components/home/HomeSection.astro';
import EventFilters from '../../components/events/EventFilters.astro';
import EventGrid from '../../components/events/EventGrid.astro';
import EventEmptyState from '../../components/events/EventEmptyState.astro';
import EventResultsSummary from '../../components/events/EventResultsSummary.astro';
import EventSearch from '../../components/events/EventSearch.astro';
import EventsHero from '../../components/events/EventsHero.astro';
import FeaturedEvent from '../../components/events/FeaturedEvent.astro';
import FeaturedSeriesPanel from '../../components/events/FeaturedSeriesPanel.astro';
import MobileFilterSheet from '../../components/events/MobileFilterSheet.astro';
import Button from '../../components/ui/Button.astro';
import Container from '../../components/ui/Container.astro';
import ExternalAction from '../../components/ui/ExternalAction.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { SPEAKER_INVITATION } from '../../content/about';
import { eventCatalog } from '../../content';
import { EVENTS_PAGE, EVENTS_STATES } from '../../content/events-marketplace';
import { EVENT_TYPES } from '../../content/events';
import { publicConfig } from '../../config';
import { resolvePublicEventConfig, registrationFeatureState } from '../../config/event-config';
import { byEndDescending, byStartAscending, isPast, isUpcoming } from '../../lib/event-catalog';

const events = await eventCatalog.listApprovedEvents();
const upcoming = events.filter(isUpcoming).sort(byStartAscending);
const past = events.filter(isPast).sort(byEndDescending);

/*
 * The featured slot takes the first APPROVED upcoming event, never a sample.
 * A review fixture given top billing on the marketplace is the one place a
 * fixture would be most convincingly mistaken for an announcement.
 */
const featured = upcoming.find((event) => event.contentStatus === 'approved');

const eventConfig = resolvePublicEventConfig(import.meta.env);
const service =
  registrationFeatureState(eventConfig, events.length) === 'endpoint-available'
    ? 'available'
    : 'unavailable';

/* Only when an APPROVED future instance exists may the series panel link to one. */
const nextExchange = upcoming.find(
  (event) => event.type === 'ai-exchange' && event.contentStatus === 'approved',
);
void publicConfig;
---

<BaseLayout
  route="/events"
  title={EVENTS_PAGE.title}
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Events' }]}
>
  <EventsHero />

  {featured && <FeaturedEvent event={featured} service={service} />}

  <FeaturedSeriesPanel nextInstanceSlug={nextExchange?.slug} />

  <HomeSection id="upcoming" labelledby="upcoming-heading">
    <Container>
      <SectionHeading as="h2" id="upcoming-heading">Upcoming public events</SectionHeading>

      <div class="toolbar" data-event-toolbar>
        <EventSearch />
        <EventFilters />
      </div>
      <div class="toolbar__mobile"><MobileFilterSheet /></div>

      <EventResultsSummary count={upcoming.length} />

      {
        upcoming.length > 0 ? (
          <EventGrid events={upcoming} service={service} id="event-results" />
        ) : (
          <EventEmptyState
            heading={EVENTS_STATES.noUpcoming.heading}
            body={EVENTS_STATES.noUpcoming.body}
            actionLabel="See what PAAIPE runs"
            actionHref="/programs"
          />
        )
      }

      {
        /*
         * Rendered but hidden, and revealed by the enhancement only when a
         * filter combination matches nothing. Server-side there is no filter,
         * so it is never the initial state.
         */
      }
      <div data-event-no-matches hidden>
        <EventEmptyState
          heading={EVENTS_STATES.noMatches.heading}
          body={EVENTS_STATES.noMatches.body}
          actionLabel={EVENTS_STATES.noMatches.action}
          actionHref="/events"
        />
      </div>
    </Container>
  </HomeSection>

  <HomeSection id="past" tone="raised" labelledby="past-heading">
    <Container>
      <SectionHeading as="h2" id="past-heading">Past public events</SectionHeading>
      {
        past.length > 0 ? (
          <EventGrid events={past} service={service} />
        ) : (
          <EventEmptyState
            heading={EVENTS_STATES.noPast.heading}
            body={EVENTS_STATES.noPast.body}
          />
        )
      }
    </Container>
  </HomeSection>

  <HomeSection id="event-types" labelledby="event-types-heading">
    <Container>
      <SectionHeading as="h2" id="event-types-heading">Other kinds of session</SectionHeading>
      <dl class="types">
        {
          EVENT_TYPES.map((type) => (
            <div>
              <dt>{type.name}</dt>
              <dd>{type.description}</dd>
            </div>
          ))
        }
      </dl>
    </Container>
  </HomeSection>

  <!-- Speaker invitation -->
  <HomeSection id="speaker-invitation" labelledby="speaker-invitation-heading">
    <Container>
      <SectionHeading as="h2" id="speaker-invitation-heading">
        {SPEAKER_INVITATION.heading}
      </SectionHeading>
      <p class="hero-lead">{SPEAKER_INVITATION.body}</p>
      <div class="section-actions">
        <Button as="a" href="/speakers" variant="primary">Speak at PAAIPE</Button>
        <ExternalAction
          action="speaker-interest"
          label={SPEAKER_INVITATION.primaryCta}
          variant="secondary"
        />
      </div>
    </Container>
  </HomeSection>

  <!-- Membership CTA -->
  <HomeSection id="membership-cta" tone="inverse" labelledby="membership-cta-heading">
    <Container>
      <div class="cta-body">
        <h2 class="cta-heading" id="membership-cta-heading">
          Members join every session, every month.
        </h2>
        <p>
          Membership includes the monthly PAAIPE AI Exchange and other eligible sessions as they are
          announced.
        </p>
        <div class="section-actions">
          <ExternalAction
            action="membership-application"
            label="Apply for Membership"
            variant="primary"
            onDark
          />
          <Button as="a" href="/membership" variant="secondary" onDark>Review Membership</Button>
        </div>
      </div>
    </Container>
  </HomeSection>

  <script>
    import '../../scripts/events-marketplace';
  </script>
</BaseLayout>

<style>
  /*
   * THE TOOLBAR IS HIDDEN UNTIL SCRIPTING IS CONFIRMED, and a test caught this
   * rather than review: without JavaScript the "Clear filters" button rendered
   * enabled and could not act. The standing rule here is that a control which
   * cannot work is not rendered - a dead button invites an action the page
   * cannot complete, which is worse than not offering one.
   *
   * `html.js` is set before first paint by the layout, so this never flashes.
   * Without scripting the search and filters are simply absent and the full
   * server-rendered list stands, which is the honest fallback.
   */
  .toolbar,
  .toolbar__mobile {
    display: none;
  }
  .toolbar {
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: end;
    margin-block: var(--space-5);
  }
  .toolbar__mobile {
    margin-block: var(--space-4);
  }
  .types {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-5);
  }
  .types dt {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-heading);
  }
  .types dd {
    margin: 0;
  }
  @media (min-width: 48em) {
    :global(html.js) .toolbar {
      display: flex;
    }
  }
  @media (max-width: 47.999em) {
    :global(html.js) .toolbar__mobile {
      display: block;
    }
  }
</style>
