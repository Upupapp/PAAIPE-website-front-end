---
import RouteScaffold from '../../components/RouteScaffold.astro';
import { publishedEvents } from '../../content';

export function getStaticPaths() {
  // Driven by the validated registry and the content mode. In a production
  // build no event is approved yet, so this correctly generates NOTHING - an
  // event detail page for an event that does not exist would be a fabrication.
  return publishedEvents.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

const { event } = Astro.props;
---

<RouteScaffold route="/events/[slug]">
  <p>
    Detail template for <strong>{event.title}</strong>. Tab 07 implements the full layout, including
    the members-only locked panel. No registration link, meeting URL or speaker is represented here.
  </p>
</RouteScaffold>
