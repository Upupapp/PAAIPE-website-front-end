---
/**
 * /events/[slug] - the event detail experience (Tab 04).
 *
 * THE LEGACY BRIDGE IS GONE. Tab 03 generated these paths from the new registry
 * but rendered them through `toLegacyEvent`, a deliberately temporary mapping
 * with two lossy conversions written down at the time: `cancelled` became
 * `postponed`, which implies a new date will come, and `waitlist`/`full` both
 * became `limited-capacity`. This template now renders the record itself, so
 * both lies are gone rather than compensated for.
 *
 * ONE RESOLVER DECIDES STATE. `resolveEventAction` produces the badge, the
 * message, whether a registration path exists and the tone, and the notice
 * banner, hero badge, facts row and registration panel all read that one model.
 * They cannot disagree about whether an event is cancelled, because none of them
 * works it out.
 *
 * SECTION ORDER IS THE COMMAND'S, and the notice sits at position 2 - above the
 * hero. A cancellation announced below a hero that still invites registration
 * has been announced in the wrong order.
 *
 * OPTIONAL SECTIONS DISAPPEAR RATHER THAN DEGRADE. No outcomes, no audience, no
 * agenda, no related events means no heading either. The command is explicit:
 * "Hide an optional section when its content is unapproved. Do not fill gaps
 * with generated claims."
 *
 * NOTHING PRIVATE CAN LEAK, structurally. The record type has no `zoomUrl`, no
 * meeting id and no passcode, so the only thing this page can say about an
 * online destination is the approved `formatLabel` - "Private Zoom".
 */
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Container from '../../components/ui/Container.astro';
import EventAgenda from '../../components/events/EventAgenda.astro';
import EventAudience from '../../components/events/EventAudience.astro';
import EventFacts from '../../components/events/EventFacts.astro';
import EventFaq from '../../components/events/EventFaq.astro';
import EventHero from '../../components/events/EventHero.astro';
import EventNoticeBanner from '../../components/events/EventNoticeBanner.astro';
import EventOutcomes from '../../components/events/EventOutcomes.astro';
import EventRegistrationPanel from '../../components/events/EventRegistrationPanel.astro';
import EventShareActions from '../../components/events/EventShareActions.astro';
import EventSpeaker from '../../components/events/EventSpeaker.astro';
import HostedByPAAIPE from '../../components/events/HostedByPAAIPE.astro';
import RelatedEvents from '../../components/events/RelatedEvents.astro';
import { CONTENT_MODE } from '../../config/content-mode';
import { allEventRecords, allEventSpeakers } from '../../content';
import {
  DETAIL_HEADINGS,
  DETAIL_METADATA,
  REGISTRATION_EXPLAINER,
  aboutFallback,
  detailFaqs,
} from '../../content/events-detail';
import { isPublishableEvent } from '../../lib/event-catalog';
import { resolveEventAction } from '../../lib/event-action';
import { resolvePublicEventConfig, registrationFeatureState } from '../../config/event-config';
import { eventRecordStructuredData } from '../../lib/event-structured-data';
import { seoContext } from '../../lib/seo';
import { publicConfig } from '../../config';

export function getStaticPaths() {
  /*
   * The published set, in this content mode. An unpublished slug has no page at
   * all and reaches the branded not-found response without revealing that a
   * draft record exists - the command's rule, and the same one the registration
   * route applies.
   */
  const published = allEventRecords.filter((record) => isPublishableEvent(record, CONTENT_MODE));

  return published.map((record) => ({
    params: { slug: record.slug },
    props: {
      event: record,
      /*
       * Related events are resolved HERE, against the published set, not in the
       * component. A related slug may name a record that is unapproved or absent
       * from this content mode, and following it blindly would put a link to the
       * not-found page under a heading reading "Related events".
       */
      related: record.relatedSlugs
        .map((slug) => published.find((candidate) => candidate.slug === slug))
        .filter(
          /*
           * A TYPE PREDICATE, not a truthiness filter. Under
           * `noUncheckedIndexedAccess` a plain `.filter(Boolean)` leaves the
           * element `T | undefined`, and the component would have had to accept
           * a maybe-undefined event - which is how an unresolved slug reaches a
           * renderer at all. Narrowing here keeps the component's prop honest.
           *
           * The predicate names the ELEMENT TYPE OF `published`, not
           * `PublicEventRecord`. The registry is Zod-validated, so its inferred
           * arrays are mutable while the interface declares them `readonly`;
           * mutable-to-readonly is assignable, the reverse is not, and asserting
           * the interface here would have run that check backwards.
           */
          (candidate): candidate is (typeof published)[number] =>
            candidate !== undefined && candidate.slug !== record.slug,
        ),
    },
  }));
}

const { event, related } = Astro.props;

const eventConfig = resolvePublicEventConfig(import.meta.env);
const service =
  registrationFeatureState(eventConfig, 1) === 'endpoint-available' ? 'available' : 'unavailable';

const action = resolveEventAction(event, service);
const speakers = allEventSpeakers.filter((speaker) => event.speakerIds.includes(speaker.id));
const faqs = detailFaqs(event, Boolean(eventConfig.supportUrl));
const about = event.description.length > 0 ? event.description : null;
const aboutFallbackCopy = about ? null : aboutFallback(event.topicTags[0]);
const path = `/events/${event.slug}`;

/*
 * Event JSON-LD, Tab 09. `seoContext` is the single gate on the APPROVED origin
 * - not merely a configured one - so this cannot become a sixth call site that
 * forgot to check. It returns null for a sample, a draft, a members-only
 * session, an undated event, a non-online event with no approved address, or
 * any build with no approved origin, and the layout drops nulls.
 *
 * This is NOT a claim of Google rich-result eligibility; see the module header.
 */
const eventJsonLd = eventRecordStructuredData(event, {
  origin: seoContext(publicConfig.siteUrl, CONTENT_MODE).siteUrl,
  speakers: allEventSpeakers,
});

/*
 * ONE trail, used twice. `BaseLayout`'s `breadcrumbs` prop emits BreadcrumbList
 * JSON-LD and renders nothing; its own comment requires the visible trail to
 * match. Building the array once and passing the same value to both is what
 * makes that true rather than merely intended - the first version of this page
 * passed the prop and forgot the visible trail, so the structured data
 * described a trail no reader could see.
 */
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Events', href: '/events' },
  { label: event.title },
];
---

<BaseLayout
  route="/events/[slug]"
  path={path}
  title={`${event.seo.title || event.title} | ${DETAIL_METADATA.titleSuffix}`}
  description={event.seo.description || DETAIL_METADATA.fallbackDescription(event.title)}
  detail={{ approved: event.contentStatus === 'approved' }}
  jsonLd={[eventJsonLd]}
  breadcrumbs={crumbs}
>
  <Container>
    <div class="detail">
      <Breadcrumbs items={crumbs} />

      <EventNoticeBanner action={action} access={event.access} />

      <EventHero event={event} action={action} />

      <section class="detail__facts" aria-labelledby="event-facts">
        <h2 id="event-facts" class="sr-only">Event details</h2>
        <EventFacts event={event} action={action} />
      </section>

      <div class="detail__panel">
        <EventRegistrationPanel action={action} access={event.access} />
      </div>

      {
        (about || aboutFallbackCopy) && (
          <section aria-labelledby="event-about">
            <h2 id="event-about">{DETAIL_HEADINGS.about}</h2>
            {about ? about.map((paragraph) => <p>{paragraph}</p>) : <p>{aboutFallbackCopy}</p>}
          </section>
        )
      }

      <EventOutcomes outcomes={event.learningOutcomes} heading={DETAIL_HEADINGS.outcomes} />

      <EventAudience audience={event.audience} heading={DETAIL_HEADINGS.audience} />

      <EventAgenda type={event.type} agenda={event.publicAgenda} heading={DETAIL_HEADINGS.agenda} />

      <EventSpeaker speakers={speakers} heading={DETAIL_HEADINGS.speaker} />

      {
        /*
         * THE EXPLAINER IS AN INSTRUCTION, so it appears only where the
         * instruction can be followed. On a cancelled or completed event it
         * told a reader to "enter an email address you can access" and watch
         * their inbox for an event that will never happen - the page said
         * "Event cancelled" twice above and then explained how to join it.
         *
         * The gate is LIFECYCLE, not `formEnabled`. With no endpoint configured
         * `formEnabled` is false on every page in production, and hiding the
         * explainer there would remove a true and useful description of how
         * PAAIPE registration works from a scheduled event that simply has not
         * been connected yet.
         */
        event.lifecycle === 'scheduled' && (
          <section aria-labelledby="event-how-to-join">
            <h2 id="event-how-to-join">{REGISTRATION_EXPLAINER.heading}</h2>
            <ol class="detail__steps">
              {REGISTRATION_EXPLAINER.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
            <p class="detail__security">{REGISTRATION_EXPLAINER.securityNote}</p>
          </section>
        )
      }

      <EventFaq faqs={faqs} heading={DETAIL_HEADINGS.faqs} />

      <EventShareActions path={path} />

      <RelatedEvents events={related} service={service} heading={DETAIL_HEADINGS.related} />

      <HostedByPAAIPE />
    </div>
  </Container>
</BaseLayout>

<script>
  import '../../scripts/event-detail';
</script>

<style>
  /*
   * ONE PANEL, MOVED - NOT TWO PANELS, ONE HIDDEN.
   *
   * The first version of this page rendered the registration panel twice, once
   * inline for narrow viewports and once in a sticky column for wide ones, with
   * CSS hiding whichever did not apply. Both were in the DOM, so the build
   * carried two `complementary` landmarks with the same accessible name and a
   * duplicate `event-registration` id on every event page - caught by
   * `verify:html`, not by looking at it, because each viewport looked correct.
   *
   * There is now ONE panel. It is a direct child of the grid at its document
   * position - section 5, where the command puts it - so a narrow viewport, a
   * keyboard and a screen reader all meet it in the right order with no CSS
   * involved. On a wide viewport it moves to the second column and becomes
   * sticky. Reading order never changes; only placement does.
   */
  .detail {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8);
    min-width: 0;
  }
  .detail :global(h2) {
    margin: 0 0 var(--space-3);
  }
  .detail :global(p) {
    color: var(--color-text-primary);
    max-width: 70ch;
  }
  .detail__steps {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding-inline-start: var(--space-4);
  }
  .detail__security {
    color: var(--color-text-secondary);
  }

  @media (min-width: 64rem) {
    .detail {
      grid-template-columns: minmax(0, 1fr) 20rem;
      column-gap: var(--space-8);
      /*
       * Row gap is zero and the spacing moves onto the children, because the
       * panel spans far more rows than the page has. Empty implicit rows are
       * themselves zero-height, but a row GAP between each of them is not - it
       * would add a screenful of blank space below the content.
       */
      row-gap: 0;
      align-items: start;
    }
    .detail > :global(*) {
      grid-column: 1;
      margin-block-end: var(--space-8);
    }
    .detail__panel {
      grid-column: 2;
      /*
       * Spans every row so the sticky containing block is the full height of
       * the page rather than the one row the panel was placed in - a sticky
       * element can only travel within its own grid area.
       */
      grid-row: 1 / span 100;
      position: sticky;
      /* Clears the 72px sticky header plus a gap. */
      top: calc(72px + var(--space-4));
      margin-block-end: 0;
    }
  }
</style>
