# PAAIPE Public Information Portal - PUBLIC frontend configuration only.
#
# Every value here is inlined into the built client bundle. Never put a secret,
# token, private Zoom link, protected download URL or personal data in this file
# or in a real .env.
#
# Every URL is OPTIONAL. When one is absent the site renders an honest
# "unavailable" state instead of a dead link or a fake success.
# Values must be absolute https:// URLs; http:// is rejected as insecure.

# Absolute origin the site is served from (used by Tab 14 for canonical URLs).
PUBLIC_SITE_URL=https://example.org

# Where "Apply for Membership" hands off to.
PUBLIC_MEMBERSHIP_APPLICATION_URL=

# Where "Member Sign In" hands off to.
PUBLIC_MEMBER_PORTAL_URL=

# Where "Check Application Status" hands off to.
PUBLIC_APPLICATION_STATUS_URL=

# Where "Express Interest as a Speaker" / "Propose a Session" hands off to.
PUBLIC_SPEAKER_INTEREST_URL=

# Where "Start a Partnership Conversation" hands off to.
PUBLIC_PARTNERSHIP_INTEREST_URL=

# Approved public contact address used for mailto: handoffs.
PUBLIC_CONTACT_EMAIL=
